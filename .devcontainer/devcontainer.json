{
    "name": "model-builder-and-deployer",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "mounts": [
        "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/secrets/.aws,target=/home/vscode/.aws,type=bind,consistency=cached",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/secrets/.aws,target=/home/vscode/secrets/.aws,type=bind,consistency=cached"
    ],
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "installOhMyZsh": false,
            "username": "vscode",
            "uid": "1000",
            "gid": "1000",
            "upgradePackages": false
        },
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "moby": true,
            "dockerDashComposeVersion": "v2"
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/aws-cli:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        }
    },
    "containerEnv": {
        "KUBECONFIG": "/workspace/.iac/kubeconfig.yaml"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "github.copilot",
                "github.copilot-chat",
                "clemenspeters.format-json",
                "euskadi31.json-pretty-printer",
                "jgalianoz.qr-generator",
                "github.vscode-github-actions"
            ]
        }
    },
    "postCreateCommand": "echo 'export KUBECONFIG=/workspace/.iac/kubeconfig.yaml' >> /home/vscode/.bashrc && kubectl version --client=true && chmod 700 /home/vscode/.ssh && chmod 600 /home/vscode/.ssh/* 2>/dev/null || true",
    "remoteUser": "vscode"
}

{
    "name": "model-builder-and-deployer",
    "dockerComposeFile": "docker-compose.yaml",
    "service": "workspace",
    "workspaceFolder": "/workspace",
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind",
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],
    "features": {
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {},
        "ghcr.io/devcontainers/features/aws-cli:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "clemenspeters.format-json",
                "euskadi31.json-pretty-printer",
                "jgalianoz.qr-generator",
                "github.vscode-github-actions"
            ]
        }
    },
    "postCreateCommand": "kubectl version --client=true && sudo chown -R ubuntu:ubuntu /home/ubuntu/.ssh && sudo chmod 700 /home/ubuntu/.ssh && sudo chmod 600 /home/ubuntu/.ssh/* 2>/dev/null || true",
    "remoteUser": "ubuntu"
}

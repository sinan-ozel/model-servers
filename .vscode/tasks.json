{
    "version": "2.0.0",
    "inputs": [
        {
          "id": "modelFile",
          "type": "pickString",
          "description": "Select model metadata file",
          "options": [
            "deepseek-r1_7b.yaml",
            "deepseek-r1_1.5b.yaml",
            "deepseek-r1_8b.yaml",
            "deepcoder_1.5b.yaml",
            "deepcoder_14b.yaml",

            "mistral-small3.2_24b.yaml",
            "mistral_7b.yaml",
            "mixtral_8x7b.yaml",
            "magistral_24b.yaml",
            "devstral_24b.yaml",

            "gemma2_2b.yaml",
            "gemma2_9b.yaml",
            "gemma2_27b.yaml",

            "all-minilm_33m.yaml",
            "embeddinggemma_300m.yaml",
            "qwen3-embedding_0.6b.yaml",
            "qwen3-embedding_4b.yaml",
            "qwen3-embedding_8b.yaml",

            "gemma3_270m.yaml",
            "gemma3_1b.yaml",
            "gemma3_4b.yaml",
            "gemma3_12b.yaml",
            "gemma3_27b.yaml",
            "gemma3_1b-it-qat.yaml",
            "gemma3_4b-it-qat.yaml",
            "gemma3_12b-it-qat.yaml",
            "gemma3_27b-it-qat.yaml",
            "gemma3-tools_27b-it-qat.yaml",

            "gemma3n_e2b.yaml",
            "gemma3n_e4b.yaml",

            "phi4-mini-reasoning_3.8b.yaml",

            "qwen3_0.6b.yaml",
            "qwen3_1.7b.yaml",
            "qwen3_4b.yaml",
            "qwen3_8b.yaml",
            "qwen3_14b.yaml",
            "qwen3_32b.yaml",
            "qwen3_30b-a3b.yaml",
            "qwen3_235b-a22b.yaml",

            "qwen3-coder_30b.yaml",

            "qwen2.5vl_3b.yaml",
            "qwen2.5vl_7b.yaml",
            "qwen2.5vl_32b.yaml",
            "qwen2.5vl_72b.yaml",

            "qwen3-vl_2b.yaml",
            "qwen3-vl_4b.yaml",
            "qwen3-vl_8b.yaml",
            "qwen3-vl_30b.yaml",
            "qwen3-vl_32b.yaml",
            "qwen3-vl_235b.yaml",

            "llava_7b.yaml",

            "llama3.2-vision_11b.yaml",
            "llama3.2-vision_90b.yaml",

            "minicpm-v_8b.yaml",

            "deepseek-ocr_3b.yaml",

            "gpt-oss_20b.yaml",
            "gpt-oss_120b.yaml"
          ],
          "default": "gemma2_2b.yaml"
        }
      ],
      "tasks": [
        {
            "label": "build_ollama_single_model_server",
            "type": "shell",
            "linux": {
                "command": "bash",
                "args": [
                    "./scripts/build_ollama_single_model_server.sh",
                    "model_metadata/${input:modelFile}"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "inspect_ollama_single_model_server",
            "dependsOn": "build_ollama_single_model_server",
            "type": "shell",
            "linux": {
                "command": "bash",
                "args": [
                    "./scripts/inspect_ollama_single_model_server.sh",
                    "model_metadata/${input:modelFile}"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "push_ollama_single_model_server_to_aws",
            "dependsOn": [
                "build_ollama_single_model_server",
                "inspect_ollama_single_model_server"
            ],
            "type": "shell",
            "linux": {
                "command": "bash",
                "args": [
                    "./scripts/push_ollama_single_model_server_to_aws.sh",
                    "model_metadata/${input:modelFile}"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "AWS_REGION": "${config:aws.region}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "push_ollama_single_model_server_to_dockerhub",
            "dependsOn": [
                "build_ollama_single_model_server",
                "inspect_ollama_single_model_server"
            ],
            "type": "shell",
            "linux": {
                "command": "bash",
                "args": [
                    "./scripts/push_ollama_single_model_server_to_dockerhub.sh",
                    "model_metadata/${input:modelFile}"
                ]
            },
            "options": {
                "env": {
                    "DOCKERHUB_NAMESPACE": "${config:docker.hub.namespace}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "full_pipeline",
            "dependsOn": [
                "build_ollama_single_model_server",
                "inspect_ollama_single_model_server",
                "push_ollama_single_model_server_to_aws",
                "push_ollama_single_model_server_to_dockerhub"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}